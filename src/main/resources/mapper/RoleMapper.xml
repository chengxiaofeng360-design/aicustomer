<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aicustomer.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.aicustomer.entity.Role">
        <id column="id" property="id" />
        <result column="role_name" property="roleName" />
        <result column="role_code" property="roleCode" />
        <result column="description" property="description" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />

        <result column="version" property="version" />
    </resultMap>

    <sql id="Base_Column_List">
        id, role_name, role_code, description, status, 
        create_time, update_time, create_by, update_by, version
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM sys_role
        WHERE id = #{id}
    </select>
    
    <select id="selectByName" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM sys_role
        WHERE role_name = #{roleName}
    </select>
    
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM sys_role
        WHERE role_code = #{roleCode}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List" />
        FROM sys_role
        WHERE 1=1
        <if test="roleName != null and roleName != ''">
            AND role_name LIKE concat('%', #{roleName}, '%')
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT r.*
        FROM sys_role r
        LEFT JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role (
            role_name, role_code, description, status,
            create_time, update_time, create_by, update_by, version
        ) VALUES (
            #{roleName}, #{roleCode}, #{description}, #{status},
            NOW(), NOW(), #{createBy}, #{updateBy}, 1
        )
    </insert>

    <update id="update">
        UPDATE sys_role
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="roleCode != null">role_code = #{roleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW(),
            <if test="updateBy != null">update_by = #{updateBy},</if>
            version = version + 1
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        DELETE FROM sys_role WHERE id = #{id}
    </update>
    
    <insert id="insertRolePermission">
        INSERT INTO sys_role_permission (role_id, permission_id, create_time, create_by)
        VALUES (#{roleId}, #{permissionId}, NOW(), 'system')
    </insert>
    
    <delete id="deleteRolePermissions">
        DELETE FROM sys_role_permission WHERE role_id = #{roleId}
    </delete>

</mapper>
