# Dify集成配置模板
# 使用说明：
# 1. 在Dify中获取API Key（格式：app-xxxxxxxxxxxxx）
# 2. 将下面的配置复制到 src/main/resources/application.yml
# 3. 替换 YOUR_DIFY_API_KEY 为实际的API Key
# 4. 保存并重启服务

# AI引擎配置
ai:
  engine: dify  # 设置Dify为主引擎（Legacy作为自动降级备选）

# Dify平台配置
dify:
  enabled: true  # 启用Dify
  api:
    url: http://localhost/v1  # Dify API地址（本地部署）
    key: YOUR_DIFY_API_KEY  # 替换为您的Dify API Key
  timeout: 30000  # 超时时间（毫秒）
  max-retries: 2  # 失败重试次数
  health-check-interval: 60000  # 健康检查间隔（毫秒）
  traffic-percentage: 100  # 100%流量使用Dify

# Circuit Breaker配置（已配置，无需修改）
resilience4j:
  circuitbreaker:
    instances:
      dify:
        failure-rate-threshold: 50
        slow-call-rate-threshold: 80
        slow-call-duration-threshold: 5000
        wait-duration-in-open-state: 60000
        permitted-number-of-calls-in-half-open-state: 3
        sliding-window-size: 10
        minimum-number-of-calls: 5
