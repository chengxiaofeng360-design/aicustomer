{
  "openapi": "3.1.0",
  "info": {
    "title": "AICustomerTools",
    "description": "Tools for querying AI Customer system backend",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://host.docker.internal:8085"
    }
  ],
  "paths": {
    "/api/dify/tools/customer/count": {
      "post": {
        "operationId": "getCustomerCount",
        "description": "Get total count of customers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "string",
                    "default": "admin",
                    "description": "Current operating user"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/dify/tools/customer/list": {
      "post": {
        "operationId": "getCustomerList",
        "description": "Get list of customers with filtering",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "string",
                    "default": "admin"
                  },
                  "region": {
                    "type": "string",
                    "description": "Filter by region (e.g. North, South)"
                  },
                  "level": {
                    "type": "integer",
                    "description": "Customer level (1=Normal, 2=VIP)"
                  },
                  "limit": {
                    "type": "integer",
                    "default": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/dify/tools/customer/detail": {
      "post": {
        "operationId": "getCustomerDetail",
        "description": "Get details of a specific customer by name",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "string",
                    "default": "admin"
                  },
                  "name": {
                    "type": "string",
                    "description": "Exact name of the customer"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}